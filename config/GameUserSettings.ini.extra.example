; ============================================================================
;  GameUserSettings.ini 自定义覆盖示例文件
;
;  用法：复制为同目录下的 GameUserSettings.ini.extra（去掉 .example 后缀）
;       容器启动时会把这里的每一项按键名合并进生成的 GameUserSettings.ini：
;         - 与容器生成的同名键 -> 直接覆盖
;         - 新键               -> 追加到对应小节（小节不存在会自动创建）
;       所以这里只需要写「要改的那几行」，不必照抄整份配置。
;
;  改动后执行：docker compose up -d  （或 docker compose run --rm ark render）
; ============================================================================

[ServerSettings]
; 例：死亡不掉落物品
; ItemStatClamps=0
; 例：允许飞行生物被其他飞行生物抓取
; AllowFlyerCarryPvE=True
; 例：关闭 PvE 炮塔对野生生物的伤害
; bDisableFriendlyFire=True
; 例：3 倍经验（与 .env 冲突时，以本文件为准）
; XPMultiplier=3
; 例：服务器公告（玩家进服可见）
; Message=欢迎来到本服，加群 XXX 领取新手礼包
; 例：关闭结构衰减
; DisableStructureDecayPvE=True

[/Script/Engine.GameSession]
; MaxPlayers=100

; ---------------------------------------------------------------------------
; 也可以追加容器没有暴露的小节
; [SessionSettings]
; SessionName=新的服务器名字

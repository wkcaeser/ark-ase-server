# =============================================================================
#  方舟：生存进化（ASE）专用服务器 —— 环境变量配置模板
#  复制为 .env 后按需修改：  cp .env.example .env
#
#  ⚠ 写法约定：注释请单独占一行，不要写在值的后面。
#    （行内注释可能被当作值的一部分，如 TAMING_SPEED_MULTIPLIER=20  # 驯龙快
#      会变成非法值；容器会自动兜底为 1 并给出警告，但请尽量按规范写）
#  所有倍率默认值均为 1（= 官方原版）。
# =============================================================================

# --------------------------- 数据目录（先看这段）----------------------------

# 服务端本体 / 存档 / 模组 / SteamCMD 缓存放哪里（合计约 15 GB）。
#
# ⚠ Windows + WSL 用户请务必改掉默认值，这是最常见的「装不上服务端」原因：
#   /mnt/c/...（Windows 的 C 盘）被 Docker Desktop 映射进容器时走 9p/DrvFs，
#   不保留 Linux 权限语义、chmod 近似空操作，SteamCMD 会直接报
#       ERROR! Failed to install app '376030' (Missing file permissions)
#   结果一个字节都装不上，容器还会被 restart 策略无限拉起。
#   正确做法是把数据放到 WSL 自己的文件系统（ext4）里：
#       DATA_DIR=/home/你的用户名/ark-data
#   不知道自己家目录时，在 WSL 里执行：echo $HOME
#
#   Linux 服务器 / macOS 保持默认 ./data 即可（= 仓库目录下的 data/）。
DATA_DIR=./data

# 容器启动时会自检数据目录：若发现它在 Windows/网络挂载上（权限语义不生效），
# 会直接打印修复指引并退出，避免 SteamCMD 反复失败刷屏。
# 只有在你确认要用这种目录、并愿意承担装不上风险时才设为 true。
ALLOW_WINDOWS_DATA_DIR=false

# ------------------------------- 代理 ---------------------------------------
# 留空 = 不使用代理（默认，推荐先留空）。
# 作用范围：容器运行时 —— SteamCMD 下载服务端与模组、服务端本身联网。
#
# ⚠ 变量名是 PROXY_HTTP / PROXY_HTTPS / PROXY_NO，【故意不叫 HTTP_PROXY】。
#   原因：docker compose 的变量插值优先级是「宿主机 shell 环境 > .env 文件」。
#   如果这里叫 HTTP_PROXY，那么宿主机上只要存在同名变量（Windows 系统代理设置、
#   Clash / Surge 的「系统代理」开关、WSL 的 /etc/environment 等），就会盖掉 .env
#   里的空值，把宿主机那份代理硬塞进容器 —— 而这几乎总是错的端口。典型后果：
#   SteamCMD 报 Missing file permissions / Missing configuration，且你改 .env 无效
#   （因为容器里生效的从来不是 .env 的值）。详见 README FAQ 15。
#   容器里最终生效的仍然是标准名 HTTP_PROXY / http_proxy，其它地方无需改动。
#
# ⚠ 这里的变量对 docker build **无效**。镜像构建（拉 debian 基础镜像、apt-get、
#   下载 SteamCMD）走的是 Docker 引擎自己的网络出口，构建报错请看 README FAQ 14。
#
# ⚠⚠ 先检查宿主机有没有开「TUN 模式 / 全局模式」（Clash、Surge、v2rayN 等）。
#   开了 TUN 的话，容器出网已经被整体接管，**这一层就不要配了** —— 叠加上去不是加速，
#   而是打架：TUN 的 fake-ip 会把 host.docker.internal 解析成 198.18.x.x 之类的假地址，
#   容器连不过去，SteamCMD 会卡在 'Connecting anonymously to Steam Public...Retrying...'
#   无限重试。判据：配了代理反而比不配更差，就是这种情况，清空即可。
#
# ⚠ 端口别想当然：Clash Verge 的 HTTP/SOCKS 混合端口默认是 7897，老版本才是 7890。
#   填错端口 = 代理等于没配。
#
# ⚠ 代理跑在宿主机（Windows/WSL）上时，容器里的 127.0.0.1 指的是容器自己，不是宿主机，
#   写了也连不上。必须用 host.docker.internal（compose 已加 host-gateway 声明），例如：
#       PROXY_HTTP=http://host.docker.internal:7897
#       PROXY_HTTPS=http://host.docker.internal:7897
#   同时记得在代理软件里打开「允许局域网连接 / Allow LAN」。
#
# ⚠ 只需要填大写这一组。compose 会同时把它注入成小写的 http_proxy / https_proxy ——
#   这是必须的：curl 与 SteamCMD 内部的下载链路只认小写变量名，只填大写等于没走代理。
#
# ⚠⚠ 改完这三个值后【必须重建容器】才生效：
#       docker compose up -d --force-recreate
#   环境变量在容器创建时固化；`docker compose restart` 和 restart 策略的自动重启
#   都【不会】重读 .env。只重启不重建 = 改了等于没改，这是本项目最隐蔽的坑之一。
PROXY_HTTP=
PROXY_HTTPS=

# 不走代理的地址，逗号分隔；一般留空即可
PROXY_NO=

# ---------------------------- Steam 登录方式 ---------------------------------
# 默认匿名登录（login anonymous），大多数专用服务端够用，留空即可。
#
# 少数情况下 Steam 会拒绝给匿名会话签发某个 App 的 access token，此时 SteamCMD 报的
# 却是 "Missing file permissions" / "Missing configuration"（字面意思完全误导）。
# 判据在容器的 Steam 命令行日志里：Steam/logs/appinfo_log.txt 出现
#     Requested N app access tokens, 0 received, N denied
# 也可以用简洁的对照实验确认：同环境下换成小 AppID 1007 若能装成功，即说明环境没问题。
#
# 遇到这种情况，填一个真实 Steam 账号可以绕开：
#     STEAM_USER=你的账号
#     STEAM_PASS=你的密码
# ⚠ 密码会明文保存在本机 .env，建议专门建一个服务端小号；务必别把 .env 提交进 git。
STEAM_USER=
STEAM_PASS=

# ------------------------------ 服务器身份 ----------------------------------

# 服务器名称（显示在 Steam 服务器列表里，支持中文；不能包含 ? & = 三个字符）
SESSION_NAME=方舟生存进化-专用服务器

# 进服密码，留空表示公开服务器
SERVER_PASSWORD=

# 管理员密码（游戏内按 Tab 输入 enablecheats 使用），强烈建议设置且只给自己人
SERVER_ADMIN_PASSWORD=ChangeMe_123456

# 地图名，可选：
#   TheIsland | TheCenter | ScorchedEarth_P | Ragnarok | Extinction
#   Valguero_P | Genesis | Gen2 | CrystalIsles | LostIsland | Fjordur
MAP=TheIsland

# 玩家上限
MAX_PLAYERS=70

# —— 端口 ——
# 服务器对外宣告的端口 = 它实际监听的端口，所以改 PORT 就等于改对外端口。
# ⚠ 若修改 PORT，请务必把 RAW_PORT 同步设为 PORT+1（原始套接字固定为游戏端口+1）。
PORT=7777
RAW_PORT=7778

# Steam 查询端口（客户端服务器列表发现用）
QUERY_PORT=27015

# RCON 远程管理（仅建议内网或白名单开放）
RCON_ENABLED=true
RCON_PORT=32330

# PVE 模式（false = PVP）；硬核模式
# ⚠ 这两项是「会话级」设置，服务端【只认命令行】，写进 GameUserSettings.ini 会被它
#   启动时重写配置时整行丢掉（表现为「.env 改了没反应，还是 PvP」）。
#   入口脚本已自动拼成 ?ServerPVE=True?ServerHardcore=False，不用你手动处理。
SERVER_PVE=true
SERVER_HARDCORE=false

# 难度：难度偏移 1.0 + 覆盖难度 5.0 = 野生生物最高 150 级（等同官方官服）
DIFFICULTY_OFFSET=1.0
OVERRIDE_OFFICIAL_DIFFICULTY=5.0

# 反作弊（部分模组/客户端与 BattlEye 冲突时可改 false）
BATTLEYE_ENABLED=true

# 全服驯养生物数量上限，留空 = 不限制
MAX_TAMED_DINOS=

# 自动存档间隔（分钟）
AUTO_SAVE_PERIOD_MINUTES=15

# 挂机踢出时间（秒），0 = 不踢
KICK_IDLE_PLAYERS_PERIOD=0

# ------------------------------ 玩法开关 ------------------------------------
# 取值均为 true / false

ALLOW_THIRD_PERSON=true
SHOW_MAP_PLAYER_LOCATION=true
ALLOW_FLYER_CARRY_PVE=true
DISABLE_STRUCTURE_DECAY_PVE=true
SERVER_CROSSHAIR=true

# 命中时在目标头顶飘出伤害数值（绿=我方造成，黄=我方承受）
# ⚠ 服务端只认命令行，写 ini 无效（脚本已自动拼 ?ShowFloatingDamageText=true）。
#   改成 true 后必须重建容器才生效：docker compose up -d --force-recreate
SHOW_FLOATING_DAMAGE_TEXT=true
ALLOW_HIT_MARKERS=true

# ------------------------------ 模组配置 ------------------------------------

# 是否加载三个默认模组（列表顺序即加载顺序）：
#   761535755  物品叠加（Ultra Stacks）
#   817096835  野人模组（Extinction Core / 起源2 灭绝野人）
#   1404697612 A镜（Awesome SpyGlass!）
ENABLE_DEFAULT_MODS=true

# 默认模组列表（想换野人模组的版本时改这里）
#   原始NPC Primal NPCs  = 1803395040
#   人类NPC Human NPCs   = 1443404076
# 注意：叠加类模组请保持在列表最前面，别排到内容模组后面，否则可能被覆盖而不生效
DEFAULT_MODS=761535755,817096835,1404697612

# 需要额外加载的模组 ID，逗号或空格分隔，追加在默认模组之后
# 例：EXTRA_MODS=955655993
EXTRA_MODS=

# 完全自定义模组列表：一旦填写，上面的默认模组与 EXTRA_MODS 全部失效
# 注意加载顺序，写在后面的模组会覆盖前面的
# 例：MODS=761535755,817096835,1404697612,955655993
MODS=

# 模组挂接方式：
#   auto    默认，同一个卷内用硬链接（零额外占用），跨卷自动改为复制
#   copy    总是复制，最保险；缺点是野人模组 3.1GB 会额外再占一份磁盘
#   symlink 符号链接，几乎不占额外空间（若模组加载异常请改回 auto）
MOD_LINK_MODE=auto

# ------------------------------ 倍率配置 ------------------------------------
# ⚠ 下面所有倍率都会由入口脚本写进 Game.ini 的 [/script/shootergame.shootergamemode]，
#   【不会】写进 GameUserSettings.ini —— 写在那里会被服务端启动时整行丢掉（见 README FAQ 21）。
#   所以：改倍率只改本文件，然后 docker compose up -d --force-recreate。
#   ⚠ DINO_COUNT_MULTIPLIER 调高会明显吃内存/CPU，10 倍在中等配置机器上可能卡。

# 经验倍率
XP_MULTIPLIER=1

# —— 驯养 / 繁殖 / 孵化 ——
# 驯养速度（数值越大驯得越快）
TAMING_SPEED_MULTIPLIER=1
# 蛋孵化速度（数值越大孵化越快）
EGG_HATCH_SPEED_MULTIPLIER=1
# 幼体成长速度（数值越大长得越快）
BABY_MATURE_SPEED_MULTIPLIER=1
# 交配间隔（数值越小越快）
MATING_INTERVAL_MULTIPLIER=1
# 交配过程速度（数值越大越快）
MATING_SPEED_MULTIPLIER=1
# 下蛋间隔（数值越小越快）
LAY_EGG_INTERVAL_MULTIPLIER=1
# 印记加成强度
BABY_IMPRINTING_STAT_SCALE_MULTIPLIER=1
# 幼体食物消耗速度
BABY_FOOD_CONSUMPTION_SPEED_MULTIPLIER=1

# —— 负重 ——
# 玩家每级属性点加成倍率（每点属性加的负重 = 原版 × 该倍率），想背得多就调高
PLAYER_WEIGHT_PER_LEVEL_MULTIPLIER=1
# 驯养恐龙每级负重倍率
DINO_WEIGHT_PER_LEVEL_MULTIPLIER=1
# 物品自身重量倍率：1=原版，0.5=所有物品重量减半（部分服务端版本会忽略此项，
# 最稳的减重方式是搭配叠加/减重类模组）
ITEM_WEIGHT_MULTIPLIER=1

# —— 采集 / 成长 / 消耗 ——
HARVEST_AMOUNT_MULTIPLIER=1
HARVEST_HEALTH_MULTIPLIER=1
LOOT_QUALITY_MULTIPLIER=1
CROP_GROWTH_SPEED_MULTIPLIER=1
DINO_COUNT_MULTIPLIER=1
DINO_FOOD_DRAIN_MULTIPLIER=1
DINO_STAMINA_DRAIN_MULTIPLIER=1
DINO_HEALTH_RECOVERY_MULTIPLIER=1
PLAYER_FOOD_DRAIN_MULTIPLIER=1
PLAYER_WATER_DRAIN_MULTIPLIER=1
POOP_INTERVAL_MULTIPLIER=1
FUEL_CONSUMPTION_INTERVAL_MULTIPLIER=1

# 单机模式加成（true 时玩家/恐龙属性成长整体加快，适合小规模好友服）
USE_SINGLEPLAYER_SETTINGS=false

# ------------------------------ 运维行为 ------------------------------------

# 每次启动自动更新服务端（true 时启动会先跑 SteamCMD）
AUTO_UPDATE=true
# 更新时校验文件完整性（极慢，仅在怀疑文件损坏时临时开）
STEAM_VALIDATE=false
# 每次启动更新模组
MOD_UPDATE=true
# 每次启动按环境变量重写 GameUserSettings.ini / Game.ini
# 设为 false 后容器不再覆盖配置，可以放心手动改 ini（首次仍会生成一次）
CONFIG_REGENERATE=true
# 重写前备份旧配置（保留最近 5 份到 data/backup/config）
CONFIG_BACKUP=true
# backup 子命令保留的历史备份份数
BACKUP_KEEP=10
# 停机时等待世界保存的秒数
STOP_TIMEOUT=90
# true = 启动时完全不执行 SteamCMD（离线/内网环境）
SKIP_INSTALL_ON_START=false
# SteamCMD 失败重试次数
STEAMCMD_RETRIES=3

# ------------------------------ 集群（进阶，可选）---------------------------

# 需要多地图互通时，多台服务器填同样的 CLUSTER_ID
CLUSTER_ID=
# 每张地图用独立的存档目录名，避免互相覆盖
ALT_SAVE_DIR_NAME=

# 追加任意启动参数（原样追加，不拼进地图 URL）
# 例：EXTRA_ARGS=-ForceAllowCaveFlyers
EXTRA_ARGS=

# 追加任意 URL 参数（会被拼进地图 URL，即「命令行设置」）
# 用于那些服务端【只认命令行、写 ini 会被丢掉】的设置。
# 多个用 ? 或 & 分隔，开头带不带 ? 都行。
# 例（允许洞穴飞行 + 关掉友军伤害）：
#   EXTRA_URL_ARGS=ForceAllowCaveFlyers=true?bDisableFriendlyFire=true
# 改完同样需要重建容器：docker compose up -d --force-recreate
EXTRA_URL_ARGS=
